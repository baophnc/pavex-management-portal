# Management portal (cổng 3001): cp .env.example .env.local rồi sửa .env.local (không commit file đó).

# Địa chỉ API Gateway của backend.
API_BASE_URL=http://localhost:8080

# Bản đồ nền của trang Xe trung chuyển / mạng lưới, đọc lúc chạy (không cần build lại image):
#   osm     — máy chủ tile công cộng của OpenStreetMap, CHỈ dùng khi phát triển; chính sách của OSM
#             không cho phép dùng cho production.
#   goong   — Goong (bản đồ vector), cần "Map tiles key" (không phải REST API key).
#   vietmap — VIETMAP (bản đồ vector, style "tm"), cần API key của VIETMAP.
# Key được trình duyệt gửi kèm mỗi request bản đồ nên là công khai: bắt buộc giới hạn key theo tên miền
# của portal trong console của nhà cung cấp (Goong: giới hạn URL/IP; VIETMAP: HTTP referer).
MAP_TILE_PROVIDER=osm
MAP_TILE_API_KEY=
